{
  "name": "rays-note",
  "version": "1.0.0",
  "description": "Ray's Note - Desktop Sticky Notes",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64"
  },
  "dependencies": {
    "koffi": "^2.8.0"
  },
  "build": {
    "appId": "com.rays.note",
    "productName": "Ray Notes",
    "directories": { "output": "dist" },
    "win": {
      "target": [{ "target": "portable", "arch": ["x64"] }],
      "icon": "note-icon.ico"
    },
    "extraResources": [],
    "npmRebuild": true
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  }
}
