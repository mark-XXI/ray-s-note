{
  "name": "rays-note",
  "version": "1.0.0",
  "description": "Ray's Note - Desktop Sticky Notes",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "start:test": "node scripts/start-test.js",
    "test": "node --test tests/baseline.test.js tests/note-store.test.js tests/note-model.test.js",
    "test:syntax": "node --check main.js && node --check desktop-pin.js && node --check src/storage/note-store.js && node --check src/notes/note-model.js && node --check scripts/start-test.js && node --check tests/baseline.test.js && node --check tests/note-store.test.js && node --check tests/note-model.test.js",
    "build": "electron-builder --win --x64"
  },
  "dependencies": {
    "koffi": "^2.8.0"
  },
  "build": {
    "appId": "com.rays.note",
    "productName": "Ray Notes",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "note-icon.ico"
    },
    "extraResources": [],
    "npmRebuild": true
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  }
}
